<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_menu" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Aries"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnNewChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@drawable/ic_add_circle"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp" />
        </ScrollView>
        
        <!-- 图片预览区（默认隐藏） -->
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:visibility="gone"> <!-- 默认隐藏 -->
    
            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_item_card" />
        
            <ImageView
                android:id="@+id/btnCancelPreview"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_btn_primary" 
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </FrameLayout>

        <!-- 底部输入区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <!-- 选图按钮（圆圈加号） -->
            <ImageView
                android:id="@+id/btnImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_add_circle"
                android:background="?android:attr/selectableItemBackground" />

            <!-- 文本输入框 -->
            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:hint="给 Aries 发送消息"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_main"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:textSize="15sp"
                android:scrollbars="vertical" />

            <!-- 发送按钮（纸飞机） -->
            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/send_bg"
                android:padding="12dp"
                android:src="@drawable/ic_send"
                android:scaleType="centerInside" />

        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/drawerMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_nav"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/navNewChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_new_chat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="新建对话"
                android:textColor="@color/text_main"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMainTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Aries"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackground" />
        
        <ListView
            android:id="@+id/navTopicList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="设置"
                android:textColor="@color/text_main"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>